TQ_USER=your_tqsdk_username
TQ_PASS=your_tqsdk_password
# 可选: data/ 快照备份目录, 默认项目下的 backups/; 建议指到别的盘或同步盘
# FLOWSCOPE_BACKUP_DIR=D:\FlowScopeBackups
# 可选: 加密永续第一次启动回填多少天(之后只补不完整的部分), 默认 7
# CRYPTO_BACKFILL_DAYS=7
# 可选: AI 看图分析(工具栏「AI 分析」)用的 DeepSeek, 在 platform.deepseek.com 创建 key; 不填则点按钮时提示未配置
# DEEPSEEK_API_KEY=sk-...
# 模型, 默认 deepseek-flash(DeepSeek 官方 API 里能看图的模型)
# DEEPSEEK_MODEL=deepseek-flash
# 思考强度: none / low / high / max, 默认 high; none 关掉思考, 更快更省
# DEEPSEEK_REASONING_EFFORT=high
# DEEPSEEK_BASE_URL=https://api.deepseek.com
